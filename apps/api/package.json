{
  "name": "@sportify/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm --filter \"@sportify/api^...\" -r build && pnpm build && concurrently --kill-others --names compiler,server \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@sportify/api-contracts": "workspace:*",
    "@sportify/database": "workspace:*",
    "@sportify/validation": "workspace:*",
    "@sportify/verification-email": "workspace:*",
    "argon2": "0.44.0",
    "dotenv": "17.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sportify/shared-config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "concurrently": "10.0.7",
    "typescript": "5.9.3"
  }
}
