# Optional local development files: .env.local, then .env; process env wins.
# Production injects variables and does not load these files.
NODE_ENV=development
PORT=4000
# Direct development probes use loopback and PORT. Production ingress preserves Host.
# Dashboard auth in production requires https://app.sportify.lk.

# Step 06: replace placeholders only through your protected local secret setup.
# Selected mode: mTLS with a protected instance wallet outside the checkout.
ORACLE_USER=SPORTIFY_API
ORACLE_PASSWORD=<securely-supplied-runtime-password>
ORACLE_CONNECT_STRING=tcps://<approved-host>:1522/<approved-service>
ORACLE_WALLET_DIRECTORY=<absolute-path-to-protected-extracted-instance-wallet>
ORACLE_WALLET_PASSWORD=<securely-supplied-wallet-password>
ORACLE_SCHEMA_OWNER=SPORTIFY_SCHEMA_OWNER
ORACLE_POOL_MIN=0
ORACLE_POOL_MAX=8
ORACLE_POOL_INCREMENT=1
ORACLE_POOL_IDLE_SECONDS=60
ORACLE_QUEUE_TIMEOUT_MS=1500
ORACLE_CALL_TIMEOUT_MS=1500

# Step 11 routes require completed operator setup, including a vetted local password corpus.
AUTH_REGISTRATION_ENABLED=false
# AUTH_EMAIL_KEY_VERSION=v1
# AUTH_EMAIL_KEYS={"v1":"<32-random-bytes-base64url>"}
# AUTH_SOURCE_KEY=<independent-32-random-bytes-base64url>
# AUTH_PASSWORD_BLOCKLIST_PATH=<absolute-path-to-vetted-sorted-sha1-corpus>
# AUTH_VERIFICATION_OUTBOX_MAX_ATTEMPTS=<reviewed-attempt-budget>
# AUTH_ISSUE_SOURCE_LIMIT=10
# AUTH_CONFIRM_SOURCE_LIMIT=30

# Step 12 account routes are disabled until the schema, grants and browser policy are verified.
AUTH_ACCOUNT_ENABLED=false
# AUTH_DASHBOARD_ORIGIN=https://app.sportify.lk
# AUTH_ALLOW_LOOPBACK_HTTP=false
# AUTH_CSRF_KEY=<independent-32-random-bytes-base64url>
# AUTH_RESET_KEY_VERSION=r1
# AUTH_RESET_KEYS={"r1":"<independent-32-random-bytes-base64url>"}
# Set AUTH_SOURCE_KEY and AUTH_PASSWORD_BLOCKLIST_PATH above for either auth feature.
# AUTH_SESSION_ABSOLUTE_SECONDS=43200
# AUTH_SESSION_IDLE_SECONDS=1800
# AUTH_SESSION_TOUCH_SECONDS=60
# AUTH_RESET_LIFETIME_SECONDS=1800
# AUTH_RESET_COOLDOWN_SECONDS=60
# AUTH_RESET_ACCOUNT_LIMIT=3
# AUTH_RESET_OUTBOX_MAX_ATTEMPTS=<reviewed-handoff-budget>
# AUTH_LOGIN_SOURCE_LIMIT=30
# AUTH_LOGIN_PAIR_LIMIT=<approved-per-source-and-account-per-15-minute-window>
# AUTH_SESSION_SOURCE_LIMIT=<approved-per-15-minute-window>
# AUTH_RESET_REQUEST_SOURCE_LIMIT=10
# AUTH_RESET_CONFIRM_SOURCE_LIMIT=30
