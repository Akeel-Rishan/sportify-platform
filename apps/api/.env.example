# Optional local development files: .env.local, then .env; process env wins.
# Production injects variables and does not load these files.
NODE_ENV=development
PORT=4000

# Step 06: replace placeholders only through your protected local secret setup.
# Selected mode: mTLS with a protected instance wallet outside the checkout.
ORACLE_USER=SPORTIFY_API
ORACLE_PASSWORD=<securely-supplied-runtime-password>
ORACLE_CONNECT_STRING=tcps://<approved-host>:1522/<approved-service>
ORACLE_WALLET_DIRECTORY=<absolute-path-to-protected-extracted-instance-wallet>
ORACLE_WALLET_PASSWORD=<securely-supplied-wallet-password>
ORACLE_SCHEMA_OWNER=SPORTIFY_SCHEMA_OWNER
ORACLE_POOL_MIN=0
ORACLE_POOL_MAX=8
ORACLE_POOL_INCREMENT=1
ORACLE_POOL_IDLE_SECONDS=60
ORACLE_QUEUE_TIMEOUT_MS=1500
ORACLE_CALL_TIMEOUT_MS=1500
