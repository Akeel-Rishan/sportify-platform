{
  "name": "@sportify/worker",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm --filter \"@sportify/worker^...\" -r build && tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@sportify/shared-config": "workspace:*",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@sportify/validation": "workspace:*",
    "zod": "4.6.7",
    "dotenv": "17.4.2",
    "@sportify/database": "workspace:*"
  }
}
