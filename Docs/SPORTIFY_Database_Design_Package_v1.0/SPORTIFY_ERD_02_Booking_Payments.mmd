      number resource_id FK
      timestamp starts_at_utc
      timestamp ends_at_utc
      number duration_minutes
      number line_total
    }
    BOOKING_HOLDS {
      number hold_id PK
      number tenant_id FK
      varchar hold_token_hash UK
      varchar hold_status
