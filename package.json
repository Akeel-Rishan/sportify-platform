{
  "name": "sportify-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "22.22.0",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "dev": "pnpm build:packages && concurrently --kill-others --names web,api,worker --prefix-colors blue,magenta,green \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:web": "pnpm --filter @sportify/web dev",
    "dev:api": "pnpm --filter @sportify/api dev",
    "dev:worker": "pnpm --filter @sportify/worker dev",
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "pnpm build:packages && eslint . --max-warnings 0",
    "lint:fix": "pnpm build:packages && eslint . --fix --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm build:packages && vitest run",
    "test:watch": "pnpm build:packages && vitest",
    "test:coverage": "pnpm build:packages && vitest run --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:http": "pnpm build:packages && vitest run apps/api/test",
    "oracle:connectivity": "pnpm --filter \"@sportify/api...\" -r build && node infra/scripts/oracle-connectivity-check.mjs",
    "oracle:privileges": "pnpm build:packages && node infra/scripts/oracle-privilege-check.mjs",
    "test:oracle": "pnpm build && node infra/scripts/oracle-connectivity-check.mjs && node infra/scripts/oracle-privilege-check.mjs",
    "db:plan": "pnpm --filter \"@sportify/migrations...\" -r build && node infra/scripts/database-plan.mjs",
    "db:status": "pnpm --filter \"@sportify/migrations...\" -r build && node infra/scripts/database-status.mjs",
    "db:migrate": "pnpm --filter \"@sportify/migrations...\" -r build && node infra/scripts/database-migrate.mjs",
    "db:verify": "pnpm --filter \"@sportify/migrations...\" -r build && node infra/scripts/database-verify.mjs",
    "test:oracle:runner": "pnpm --filter \"@sportify/migrations...\" -r build && node database/tests/oracle-migration-runner.mjs",
    "test:oracle:step07": "pnpm --filter \"@sportify/migrations...\" -r build && node database/tests/oracle-migration-runner.mjs",
    "db:lock-check": "pnpm --filter \"@sportify/migrations...\" -r build && node infra/scripts/database-lock-check.mjs",
    "test:oracle:step08": "pnpm --filter \"@sportify/migrations...\" -r build && node database/tests/oracle-step08.mjs"
  },
  "devDependencies": {
    "oracledb": "26.0.0",
    "@types/node": "22.20.5",
    "concurrently": "10.0.7",
    "typescript": "5.9.3",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.73.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "vitest": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "globals": "17.14.0",
    "@sportify/database": "workspace:*",
    "@sportify/validation": "workspace:*",
    "@sportify/migrations": "workspace:*"
  }
}
