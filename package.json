{
  "name": "sportify-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": "22.22.0", "pnpm": "10.34.9" },
  "scripts": {
    "dev": "pnpm build:packages && concurrently --kill-others --names web,api,worker --prefix-colors blue,magenta,green \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:web": "pnpm --filter @sportify/web dev",
    "dev:api": "pnpm --filter @sportify/api dev",
    "dev:worker": "pnpm --filter @sportify/worker dev",
    "build:packages": "pnpm --filter \"./packages/**\" -r build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "concurrently": "10.0.7",
    "typescript": "5.9.3"
  }
}
